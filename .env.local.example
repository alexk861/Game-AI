# Supabase (client-safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase (SERVER-ONLY — never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google AdMob Production Rewarded Ad Unit IDs (Optional — falls back to standard Google test unit IDs if blank)
NEXT_PUBLIC_ADMOB_REWARDED_AD_ID_IOS=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
NEXT_PUBLIC_ADMOB_REWARDED_AD_ID_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
